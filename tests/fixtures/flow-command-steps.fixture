  {
   "slug": "bash-0166",
   "needle": "if [ -d \"$dir\" ] && [ -f \"$dir/CLAUDE.md\" ]; then"
  },
  {
   "slug": "bash-0167",
   "needle": "CPP_DIR=\"$dir\""
  },
  {
   "slug": "bash-0168",
   "needle": "VERIFY_ENABLED=0"
  },
  {
   "slug": "bash-0169",
   "needle": "if [ -n \"$CPP_DIR\" ] && grep -q \"deploy_verification:\" .claude/cicd.yml 2>/dev/null; then"
  },
  {
   "slug": "bash-0170",
   "needle": "if command -v uv >/dev/null 2>&1; then"
  },
  {
   "slug": "bash-0171",
   "needle": "VERIFY_ENABLED=1"
  },
  {
   "slug": "bash-0172",
   "needle": "echo \"NOTE: deploy verification configured but 'uv' is not installed; skipping baseline + verdict.\" >&2"
  },
  {
   "slug": "bash-0173",
   "needle": "DEPLOY_MODE=$(grep -oP '^\\s*mode:\\s*\\K\\S+' .claude/deploy.yaml 2>/dev/null | head -1)"
  },
  {
   "slug": "bash-0174",
   "needle": "HEAD_SHA=$(git rev-parse --short HEAD)"
  },
  {
   "slug": "bash-0175",
   "needle": "ALREADY_DEPLOYED=0"
  },
  {
   "slug": "bash-0176",
   "needle": "if [ -f .claude/deploy.log ] && awk -F'|' -v sha=\"$HEAD_SHA\" '$2 ~ /deploy/ && $3 ~ (\"^[[:space:]]*\" sha \"[[:space:]]*$\") && $5 ~ /^[[:space:]]*0[[:space:]]*$/ { found = 1 } END { exit !found }' .claude/deploy.log; then"
  },
  {
   "slug": "bash-0177",
   "needle": "ALREADY_DEPLOYED=1"
  },
  {
   "slug": "bash-0178",
   "needle": "if [ \"$ALREADY_DEPLOYED\" -eq 1 ]; then"
  },
  {
   "slug": "bash-0179",
   "needle": "echo \"Deploy skipped: $HEAD_SHA is already recorded as successfully deployed in .claude/deploy.log\""
  },
  {
   "slug": "bash-0180",
   "needle": "echo \"(issue #597 - a concurrent session deployed this same commit; re-running would be a duplicate deploy).\""
  },
  {
   "slug": "bash-0181",
   "needle": "elif [ \"$DEPLOY_MODE\" = \"external\" ]; then"
  },
  {
   "slug": "bash-0182",
   "needle": "echo \"Deploy mode 'external' (.claude/deploy.yaml) - deploy runs out of band (host timer / CI on origin/main). Skipping inline 'make deploy'.\""
  },
  {
   "slug": "bash-0183",
   "needle": "elif [[ -f \"Makefile\" ]] && grep -q \"^deploy:\" Makefile; then"
  },
  {
   "slug": "bash-0184",
   "needle": "if [ -z \"$COMPOSE_PROJECT_NAME\" ]; then"
  },
  {
   "slug": "bash-0185",
   "needle": "DEPLOY_PROJECT=$(grep -oP '^\\s*compose_project_name:\\s*\\K\\S+' .claude/deploy.yaml 2>/dev/null | head -1)"
  },
  {
   "slug": "bash-0186",
   "needle": "if [ -z \"$DEPLOY_PROJECT\" ]; then"
  },
  {
   "slug": "bash-0187",
   "needle": "GCD=$(git rev-parse --git-common-dir 2>/dev/null)"
  },
  {
   "slug": "bash-0188",
   "needle": "if [ -n \"$GCD\" ]; then"
  },
  {
   "slug": "bash-0189",
   "needle": "COMMON_GIT_DIR=$(cd \"$GCD\" 2>/dev/null && pwd)"
  },
  {
   "slug": "bash-0190",
   "needle": "[ -n \"$COMMON_GIT_DIR\" ] && DEPLOY_PROJECT=$(basename \"$(dirname \"$COMMON_GIT_DIR\")\" | tr 'A-Z' 'a-z')"
  },
  {
   "slug": "bash-0191",
   "needle": "if [ -n \"$DEPLOY_PROJECT\" ]; then"
  },
  {
   "slug": "bash-0192",
   "needle": "export COMPOSE_PROJECT_NAME=\"$DEPLOY_PROJECT\""
  },
  {
   "slug": "bash-0193",
   "needle": "echo \"Pinned COMPOSE_PROJECT_NAME=$COMPOSE_PROJECT_NAME (issue #535: canonical prod project, not the worktree basename).\""
  },
  {
   "slug": "bash-0194",
   "needle": "if [ \"$VERIFY_ENABLED\" -eq 1 ]; then"
  },
  {
   "slug": "bash-0195",
   "needle": "echo \"Capturing pre-deploy baseline...\""
  },
  {
   "slug": "bash-0196",
   "needle": "PYTHONPATH=\"$CPP_DIR:$PYTHONPATH\" env -u UV_PROJECT_ENVIRONMENT \"CPP_RUNNER_TARGET_UV_PROJECT_ENVIRONMENT=${UV_PROJECT_ENVIRONMENT-}\" \"CPP_RUNNER_TARGET_UV_PROJECT_ENVIRONMENT_PRESENT=${UV_PROJECT_ENVIRONMENT+x}\" uv run --python 3.11 --no-python-downloads --project \"$CPP_DIR\" python -m lib.cicd verify --baseline --summary"
  },
  {
   "slug": "bash-0197",
   "needle": "echo \"Running: make deploy\""
  },
  {
   "slug": "bash-0198",
   "needle": "make deploy"
  },
  {
   "slug": "bash-0199",
   "needle": "DEPLOY_EXIT=$?"
  },
  {
   "slug": "bash-0200",
   "needle": "VERDICT=\"none\""
  },
  {
   "slug": "bash-0201",
   "needle": "echo \"Running deploy verification...\""
  },
  {
   "slug": "bash-0202",
   "needle": "PYTHONPATH=\"$CPP_DIR:$PYTHONPATH\" env -u UV_PROJECT_ENVIRONMENT \"CPP_RUNNER_TARGET_UV_PROJECT_ENVIRONMENT=${UV_PROJECT_ENVIRONMENT-}\" \"CPP_RUNNER_TARGET_UV_PROJECT_ENVIRONMENT_PRESENT=${UV_PROJECT_ENVIRONMENT+x}\" uv run --python 3.11 --no-python-downloads --project \"$CPP_DIR\" python -m lib.cicd verify"
  },
  {
   "slug": "bash-0203",
   "needle": "VERIFY_EXIT=$?"
  },
  {
   "slug": "bash-0204",
   "needle": "VERDICT=$( [ \"$VERIFY_EXIT\" -eq 1 ] && echo \"rollback\" || echo \"proceed/review\" )"
  },
  {
   "slug": "bash-0205",
   "needle": "if [ \"$VERIFY_EXIT\" -eq 1 ]; then"
  },
  {
   "slug": "bash-0206",
   "needle": "echo \"DEPLOY VERIFICATION: ROLLBACK - a probe that passed pre-deploy fails now.\""
  },
  {
   "slug": "bash-0207",
   "needle": "echo \"Recommend rolling back (redeploy previous commit) or investigating with /cicd:health + /cicd:smoke.\""
  },
  {
   "slug": "bash-0208",
   "needle": "mkdir -p .claude"
  },
  {
   "slug": "bash-0209",
   "needle": "echo \"$(date -Iseconds) | deploy | $(git rev-parse --short HEAD) | main | ${DEPLOY_EXIT} | verify:${VERDICT}\" >> .claude/deploy.log"
  },
  {
   "slug": "bash-0210",
   "needle": "echo \"No deploy target in Makefile - skipping deployment.\""
  },
