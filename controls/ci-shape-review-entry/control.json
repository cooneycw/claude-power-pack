{
  "gate": "scripts/codex-review-run.sh",
  "invocation": [
    "uv",
    "run",
    "--extra",
    "dev",
    "--frozen",
    "python",
    "controls/ci-shape-review-entry/run-case.py",
    "{gate}",
    "{case}"
  ],
  "good_exit": 0,
  "good_signal": "CI_SHAPE_REVIEW_CONTROL: admitted -",
