#!/usr/bin/env sh
# fixture: a stable replaced by a prerelease of the SAME core. Equal cores fell
# through to `upgraded`, which is the direction nobody would have checked.
STATE="${NPM_UPGRADE_FIXTURE_STATE:-/nonexistent}"
if [ "${1:-}" = "--version" ]; then
    if [ -f "$STATE/installed" ]; then echo "1.5.0-beta.1"; else echo "1.5.0"; fi
    exit 0
fi
exit 0
