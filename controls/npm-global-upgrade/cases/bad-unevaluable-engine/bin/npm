#!/usr/bin/env sh
# fixture: `^22 || ^20` is not the `>=<major>` shape the gate can evaluate, AND
# node 20 actually satisfies it. Reporting `capped` here would be a fabricated
# reason that is also false.
case "${1:-}" in
    install) exit 0 ;;
    view)
        case "${3:-}" in
            version) echo "1.5.0" ;;
            engines.node) echo "^22 || ^20" ;;
        esac
        exit 0 ;;
esac
exit 0
