#!/usr/bin/env sh
# fixture: the host is already on the published latest. The version does NOT
# move, and that is HEALTHY - the half a naive "did it change?" check gets wrong.
case "${1:-}" in
    install) exit 0 ;;
    view)
        case "${3:-}" in
            version) echo "1.5.0" ;;
            engines.node) echo ">=20.0.0" ;;
        esac
        exit 0 ;;
esac
exit 0
