#!/usr/bin/env sh
# fixture: an abbreviated constraint. `cut -d. -f2` on "22" returns "22", so the
# first cut of the comparator read this as 22.22.22 and condemned a node 22 host.
case "${1:-}" in
    install) exit 0 ;;
    view)
        case "${3:-}" in
            version) echo "1.5.0" ;;
            engines.node) echo ">=22" ;;
        esac
        exit 0 ;;
esac
exit 0
