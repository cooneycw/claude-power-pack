#!/usr/bin/env bash
# `make` is ABSENT from the negative-controls image, so each case carries its
# own. Only EXECUTION is stood in for: the Makefile beside this file is real
# text and is what the derivation reads.
#
# `verify` runs its own prerequisites, so a gate this rule does NOT name is one
# the aggregate genuinely never runs - which is the whole distinction the case
# exists to draw.
case "$1" in
    lint)
        if grep -q "LINT IS BROKEN" Makefile 2>/dev/null; then echo "LINT IS BROKEN"; exit 1; fi
        echo "lint ran"; exit 0 ;;
    verify)
        for p in $(sed -n 's/^verify:[[:space:]]*//p' Makefile); do
            "$0" "$p" || { echo "make: *** [Makefile:1: $p] Error 1" >&2; exit 2; }
        done
        echo "verify ran"; exit 0 ;;
    test|typecheck|security_scan) echo "$1 ran"; exit 0 ;;
    *) echo "make: *** No rule to make target '$1'.  Stop." >&2; exit 2 ;;
esac
