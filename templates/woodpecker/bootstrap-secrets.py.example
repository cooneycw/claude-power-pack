#!/usr/bin/env python3
"""Pull Woodpecker server secrets from AWS Secrets Manager into a docker .env.

Generalized template (Claude Power Pack /cicd:woodpecker). Copy next to your
Woodpecker server compose file and run before `docker compose up`. The output
`docker.env` is gitignored and referenced by the compose `env_file:`.

Usage:
    python3 bootstrap-secrets.py --secret-name my-woodpecker-secret
    python3 bootstrap-secrets.py --secret-name my-woodpecker-secret \\
        --region us-east-1 --keys WOODPECKER_GITHUB_CLIENT WOODPECKER_GITHUB_SECRET

The named AWS secret is expected to be a JSON object. Only the requested keys
are written to docker.env (missing keys are skipped, not errors). The existing
nonempty WOODPECKER_GRPC_SECRET always survives regeneration; it takes precedence
over AWS, and is never generated. Invalid local assignments fail before replace.
"""
from __future__ import annotations

import argparse
import json
import os
import re
import tempfile
from pathlib import Path

import boto3

# Keys a Woodpecker server typically needs. Override with --keys.
DEFAULT_KEYS = [
    "WOODPECKER_GITHUB_CLIENT",
    "WOODPECKER_GITHUB_SECRET",
    "WOODPECKER_AGENT_SECRET",
    "WOODPECKER_HOST",
    "WOODPECKER_GRPC_SECRET",
]


GRPC_KEY = "WOODPECKER_GRPC_SECRET"


def quoted_end(value: str) -> int | None:
    """Find the closing quote without treating escaped quotes as delimiters."""
    escaped = False
    for index, char in enumerate(value[1:], 1):
        if escaped:
            escaped = False
        elif char == "\\":
            escaped = True
        elif char == value[0]:
            return index
    return None


def local_signing_token(text: str) -> str | None:
    """Read logical assignments; preserve literal tokens, never dependencies."""
    existing = None
    lines = iter(text.splitlines())
    for line in lines:
        if line.lstrip().startswith("#"):
            continue
        match = re.match(r"^\s*(?:export\s+)?([^=:\s]+)\s*[:=](.*)$", line)
        if match is None:
            if re.match(r"^\s*(?:export\s+)?WOODPECKER_GRPC_SECRET(?:\s|$)", line):
                raise ValueError("WOODPECKER_GRPC_SECRET: malformed local assignment")
            continue
        key, raw = match.groups()
        raw = raw.lstrip()
        quoted = raw.startswith(("'", '"'))
        if quoted:
            end = quoted_end(raw)
            while end is None:
                continuation = next(lines, None)
                if continuation is None:
                    raise ValueError("WOODPECKER_GRPC_SECRET: unclosed local environment quote")
                raw += "\n" + continuation
                end = quoted_end(raw)
            token = raw[:end + 1]
            tail = raw[end + 1:].strip()
        else:
            token = re.split(r"\s+#", raw, maxsplit=1)[0].strip()
            tail = ""
        if key != GRPC_KEY:
            continue
        if existing is not None:
            raise ValueError("WOODPECKER_GRPC_SECRET: duplicate local assignment")
        if quoted and tail and not tail.startswith("#"):
            raise ValueError("WOODPECKER_GRPC_SECRET: content after closing quote")
        if not token or token.startswith("#") or (quoted and not token[1:-1]):
            raise ValueError("WOODPECKER_GRPC_SECRET: empty local assignment")
        if "\n" in token or "\r" in token:
            raise ValueError("WOODPECKER_GRPC_SECRET: multiline local key is unsupported")
        if not quoted and ("'" in token or '"' in token):
            raise ValueError("WOODPECKER_GRPC_SECRET: mixed local quoting is unsupported")
        if "$" in token and not token.startswith("'"):
            raise ValueError("WOODPECKER_GRPC_SECRET: local interpolation is unsupported")
        existing = token
    return existing


def write_env(path: str, values: dict, keys: list[str]) -> list[str]:
    """Preserve only the signing key, validate before atomically replacing output."""
    target = Path(path)
    existing = local_signing_token(target.read_text()) if target.exists() else None
    lines = []
    written = []
    for key in dict.fromkeys([*keys, *([GRPC_KEY] if existing is not None else [])]):
        if key == GRPC_KEY and existing is not None:
            value = existing
        elif key not in values:
            continue
        else:
            value = values[key]
            if key == GRPC_KEY:
                if value is None or value == "":
                    continue
                if not isinstance(value, str):
                    raise ValueError("WOODPECKER_GRPC_SECRET: supplied value must be text")
                if "\n" in value or "\r" in value:
                    raise ValueError("WOODPECKER_GRPC_SECRET: supplied value must occupy one line")
                if not re.fullmatch(r"[A-Za-z0-9._~+/=-]+", value):
                    raise ValueError("WOODPECKER_GRPC_SECRET: supplied value requires unsupported dotenv syntax")
            value = str(value)
        if "\n" in value or "\r" in value:
            raise ValueError("Environment values must occupy one line")
        lines.append(f"{key}={value}\n")
        written.append(key)
    temporary = None
    try:
        with tempfile.NamedTemporaryFile(mode="w", dir=target.parent, prefix=".docker-env-", delete=False) as output:
            temporary = output.name
            output.write("".join(lines))
            output.flush()
            os.fsync(output.fileno())
        os.replace(temporary, target)
    finally:
        if temporary is not None and os.path.exists(temporary):
            os.unlink(temporary)
    return written


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--secret-name",
        required=True,
        help="AWS Secrets Manager secret id (a JSON object).",
    )
    parser.add_argument(
        "--region",
        default=os.environ.get("AWS_DEFAULT_REGION", "us-east-1"),
        help="AWS region (default: $AWS_DEFAULT_REGION or us-east-1).",
    )
    parser.add_argument(
        "--keys",
        nargs="+",
        default=DEFAULT_KEYS,
        help="Secret keys to write to docker.env.",
    )
    parser.add_argument(
        "--out",
        default="docker.env",
        help="Output env file (default: docker.env, next to this script).",
    )
    args = parser.parse_args()

    session = boto3.Session(
        aws_access_key_id=os.environ.get("AWS_ACCESS_KEY_ID"),
        aws_secret_access_key=os.environ.get("AWS_SECRET_ACCESS_KEY"),
        region_name=args.region,
    )
    client = session.client("secretsmanager")
    resp = client.get_secret_value(SecretId=args.secret_name)
    secrets = json.loads(resp["SecretString"])

    out_path = args.out
    if not os.path.isabs(out_path):
        out_path = os.path.join(os.path.dirname(os.path.abspath(__file__)), out_path)

    written = write_env(out_path, secrets, args.keys)

    print(f"Wrote {out_path} with {len(written)} key(s) from {args.secret_name}: "
          f"{', '.join(written) or '(none matched)'}")


if __name__ == "__main__":
    main()
