#!/usr/bin/env python3
"""Pull Woodpecker server secrets from AWS Secrets Manager into a docker .env.

Generalized template (Claude Power Pack /cicd:woodpecker). Copy next to your
Woodpecker server compose file and run before `docker compose up`. The output
`docker.env` is gitignored and referenced by the compose `env_file:`.

Usage:
    python3 bootstrap-secrets.py --secret-name my-woodpecker-secret
    python3 bootstrap-secrets.py --secret-name my-woodpecker-secret \\
        --region us-east-1 --keys WOODPECKER_GITHUB_CLIENT WOODPECKER_GITHUB_SECRET

The named AWS secret is expected to be a JSON object. Only the requested keys
are written to docker.env (missing keys are skipped, not errors). The existing
nonempty WOODPECKER_GRPC_SECRET always survives regeneration; it takes precedence
over AWS, and is never generated. Invalid local assignments fail before replace.
"""
from __future__ import annotations

import argparse
import json
import os
import re
import tempfile
from pathlib import Path

import boto3

# Keys a Woodpecker server typically needs. Override with --keys.
DEFAULT_KEYS = [
    "WOODPECKER_GITHUB_CLIENT",
    "WOODPECKER_GITHUB_SECRET",
    "WOODPECKER_AGENT_SECRET",
    "WOODPECKER_HOST",
    "WOODPECKER_GRPC_SECRET",
]


GRPC_KEY = "WOODPECKER_GRPC_SECRET"


def write_env(path: str, values: dict, keys: list[str]) -> list[str]:
    """Preserve only the signing key, validate before atomically replacing output."""
    target = Path(path)
    existing = None
    if target.exists():
        for line in target.read_text().splitlines():
            if not re.match(r"^\s*(?:export\s+)?WOODPECKER_GRPC_SECRET(?:\s|=|$)", line):
                continue
            match = re.fullmatch(r"\s*WOODPECKER_GRPC_SECRET=(.*)", line)
            if existing is not None or match is None:
                raise ValueError("WOODPECKER_GRPC_SECRET: duplicate or malformed local assignment")
            raw = match.group(1).strip()
            checked = raw
            if raw[:1] in ("'", '\"'):
                if len(raw) < 2 or raw[-1] != raw[0]:
                    raise ValueError("WOODPECKER_GRPC_SECRET: malformed local quoting")
                checked = raw[1:-1]
            if not checked or checked.startswith("#"):
                raise ValueError("WOODPECKER_GRPC_SECRET: empty local assignment")
            existing = raw
    lines = []
    written = []
    for key in dict.fromkeys([*keys, *([GRPC_KEY] if existing is not None else [])]):
        if key == GRPC_KEY and existing is not None:
            value = existing
        elif key not in values:
            continue
        else:
            value = values[key]
            if key == GRPC_KEY:
                if value is None or value == "":
                    continue
                if not isinstance(value, str) or not value.strip():
                    raise ValueError("WOODPECKER_GRPC_SECRET: invalid supplied value")
            value = str(value)
        if "\n" in value or "\r" in value:
            raise ValueError("Environment values must occupy one line")
        lines.append(f"{key}={value}\n")
        written.append(key)
    temporary = None
    try:
        with tempfile.NamedTemporaryFile(mode="w", dir=target.parent, prefix=".docker-env-", delete=False) as output:
            temporary = output.name
            output.write("".join(lines))
            output.flush()
            os.fsync(output.fileno())
        os.replace(temporary, target)
    finally:
        if temporary is not None and os.path.exists(temporary):
            os.unlink(temporary)
    return written


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--secret-name",
        required=True,
        help="AWS Secrets Manager secret id (a JSON object).",
    )
    parser.add_argument(
        "--region",
        default=os.environ.get("AWS_DEFAULT_REGION", "us-east-1"),
        help="AWS region (default: $AWS_DEFAULT_REGION or us-east-1).",
    )
    parser.add_argument(
        "--keys",
        nargs="+",
        default=DEFAULT_KEYS,
        help="Secret keys to write to docker.env.",
    )
    parser.add_argument(
        "--out",
        default="docker.env",
        help="Output env file (default: docker.env, next to this script).",
    )
    args = parser.parse_args()

    session = boto3.Session(
        aws_access_key_id=os.environ.get("AWS_ACCESS_KEY_ID"),
        aws_secret_access_key=os.environ.get("AWS_SECRET_ACCESS_KEY"),
        region_name=args.region,
    )
    client = session.client("secretsmanager")
    resp = client.get_secret_value(SecretId=args.secret_name)
    secrets = json.loads(resp["SecretString"])

    out_path = args.out
    if not os.path.isabs(out_path):
        out_path = os.path.join(os.path.dirname(os.path.abspath(__file__)), out_path)

    written = write_env(out_path, secrets, args.keys)

    print(f"Wrote {out_path} with {len(written)} key(s) from {args.secret_name}: "
          f"{', '.join(written) or '(none matched)'}")


if __name__ == "__main__":
    main()
