# Project Makefile — Claude Power Pack Integration
#
# The /flow commands auto-discover these targets:
#   /flow:finish  → runs `make lint` and `make test` (if targets exist)
#   /flow:deploy  → runs `make deploy` (or any target you specify)
#   /flow:doctor  → reports which targets are available
#
# Copy this file to your project root as "Makefile" and customize.
# All commands use `uv run` for dependency isolation.

.PHONY: test lint format update_docs clean

## Quality gates (used by /flow:finish)

lint:
	uv run ruff check .

format:
	uv run ruff format .

test:
	uv run pytest

## Deployment (used by /flow:deploy)

# No deploy target is defined yet, on purpose (issue #1712): a target that
# only printed a TODO would report a successful deployment that deployed
# nothing. Uncomment the block below, replace its recipe with real steps, and
# add `deploy` to .PHONY (a .PHONY target with no rule makes `make deploy`
# exit 0 with "Nothing to be done").
#
# deploy:
# 	<your deploy command>
# Examples:
#    ansible-playbook deploy.yaml
#    ssh prod 'cd /app && git pull && systemctl restart app'
#    docker compose up -d --build

# deploy-staging:
# 	<your deploy command>

## Documentation (used by /flow:auto and /flow:finish)

update_docs:
	@echo "Run /documentation:c4 to regenerate C4 architecture diagrams"
	@echo "Review CLAUDE.md and README.md for accuracy"

## Utilities

clean:
	rm -rf .pytest_cache __pycache__ .ruff_cache .mypy_cache dist build *.egg-info
